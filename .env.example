# ============================================
# PAYLOAD CMS + POSTGRES
# ============================================
# Postgres connection string (Aiven or local Docker)
PAYLOAD_DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/wedding_renan_heloisa
# Optional CA certificate path for managed Postgres (Aiven, etc)
PAYLOAD_DATABASE_CA_CERT_PATH=
# Optional: set false only for troubleshooting SSL chain locally
PAYLOAD_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Payload secret (used for JWT, hashing, etc.)
# Generate a random string: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_HERE

# Base URL where the app runs
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ============================================
# CLOUDINARY (optional, for media hosting)
# ============================================
# If all vars below are provided, uploads will go to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix in Cloudinary media library
CLOUDINARY_FOLDER=wedding-renan-heloisa

# ============================================
# SMTP (Mailtrap or other provider)
# ============================================
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME=Renan e Heloisa
SMTP_FROM_ADDRESS=no-reply@example.com
